# ---------------------------------------------------------------------------
# Local development environment
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# Project-local Postgres started by `pnpm --filter @workspace/db run pg`
DATABASE_URL=postgresql://bazaar:bazaar@127.0.0.1:5433/global_bazaar

# Port the API server listens on. The Vite dev server proxies /api here.
PORT=5176
API_PORT=5176

NODE_ENV=development

# Signing key for auth tokens. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Optional: payment gateways (endpoints return 503 while unset) --------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com

# --- Optional: email (logged to console while unset) ----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@orbit.market
FROM_NAME=Orbit Market

# --- Object storage: Amazon S3 (uploads disabled while unset) -------------
# Bucket and region are required for image upload, serving and deletion.
# Block all public access on the bucket: objects are never served directly —
# the API checks the ACL and then redirects to a short-lived presigned URL.
S3_BUCKET=
S3_REGION=

# Credentials are resolved by the AWS SDK default chain, so on EC2 an attached
# instance role works and these two should be left empty. Set them only when
# running outside AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: S3-compatible endpoint (MinIO, R2). Leave empty for real AWS S3.
S3_ENDPOINT=

# Maximum accepted upload in bytes. Keep in step with client_max_body_size in
# the Nginx site config. Defaults to 10 MB.
MAX_UPLOAD_BYTES=10485760

LOG_LEVEL=info

# --- Production hardening ------------------------------------------------
# Comma-separated origin allow-list for the API. The reference deployment
# serves the web app and the API from one origin through Nginx, so same-origin
# traffic never involves CORS and this can stay empty. Set it only when a
# different origin must call the API (a separate front-end host, a mobile web
# client). With NODE_ENV=production an empty value denies all cross-origin
# requests; it is never permissive in production.
#   CORS_ORIGINS=https://example.com,https://www.example.com
CORS_ORIGINS=

# Platform cut applied to vendor earnings, as a percentage. Defaults to 10.
PLATFORM_COMMISSION_RATE=10

# PM2 worker count for the API process. Auth is stateless (JWT) so the process
# scales horizontally, but the in-memory rate limiter counts per worker — the
# effective limit becomes (limit x workers). Defaults to 1.
PM2_INSTANCES=1

# /api/seed creates an administrator with a well-known password and is blocked
# whenever NODE_ENV=production. Setting this to "true" re-enables it — never do
# that on a public deployment.
# ALLOW_SEED=false

# --- Frontend (Vite) — exported in the SHELL, not read from this file -----
# Vite's project root is artifacts/orbit-market, so it never loads this
# repo-root file. All three below must be exported before building or running
# the web artifact. PORT and BASE_PATH are required (the config throws without
# them); the Stripe key is optional and disables card checkout while unset.
#
#   PowerShell:  $env:PORT="5175"; $env:BASE_PATH="/"
#   bash:        PORT=5175 BASE_PATH=/ pnpm run build
#
# VITE_STRIPE_PUBLISHABLE_KEY is a *publishable* key — public by design and
# inlined into the bundle at build time (verified), so it is safe to ship.
#
#   PORT=5175
#   BASE_PATH=/
#   VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Optional: local Postgres helper (lib/db/scripts/local-postgres.mjs) ---
# Defaults shown; override only if 5433 is taken or you need other credentials.
# PG_PORT=5433
# PG_USER=bazaar
# PG_PASSWORD=bazaar
# PG_DATABASE=global_bazaar
